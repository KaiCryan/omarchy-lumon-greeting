#!/usr/bin/env python3
"""Lumon emblem: a wireframe globe spins on its axis, eases to rest, then the
LUMON wordmark appears. Palette and speed come from the environment (see
_lumon.py). Prints a single static frame when stdout is not a terminal."""
import math
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _lumon import COLOR, HOT, RESET, TTY, fg, nap, run, term_size, write  # noqa: E402

GW, GH = 44, 21
CX, CY = (GW - 1) / 2.0, (GH - 1) / 2.0
RX, RY = 19.0, 9.3

PARALLELS = [0.0, 0.72, -0.72]
MERIDIAN_LONS = [math.pi / 2, math.pi / 2 + 1.02, math.pi / 2 - 1.02]

LUMON = r"""
     ██╗     ██╗   ██╗ ███╗   ███╗  ██████╗  ███╗   ██╗
     ██║     ██║   ██║ ████╗ ████║ ██╔═══██╗ ████╗  ██║
     ██║     ██║   ██║ ██╔████╔██║ ██║   ██║ ██╔██╗ ██║
     ██║     ██║   ██║ ██║╚██╔╝██║ ██║   ██║ ██║╚██╗██║
     ███████╗╚██████╔╝ ██║ ╚═╝ ██║ ╚██████╔╝ ██║ ╚████║
     ╚══════╝ ╚═════╝  ╚═╝     ╚═╝  ╚═════╝  ╚═╝  ╚═══╝

           U N I T E D   I N   S E V E R A N C E
"""


def blank():
    return [[" "] * GW for _ in range(GH)]


def plot(grid, x, y, ch, hard=False):
    xi, yi = int(round(x)), int(round(y))
    if 0 <= yi < GH and 0 <= xi < GW and (hard or grid[yi][xi] == " "):
        grid[yi][xi] = ch


def stroke_char(rx, ry, a):
    sx, sy = -rx * math.sin(a), ry * math.cos(a)
    ang = math.degrees(math.atan2(sy, sx)) % 180
    top = math.cos(a) < 0
    if ang < 22 or ang >= 158:
        return "-"
    if ang < 65:
        return "\\" if top else "/"
    if ang < 115:
        return "|"
    return "/" if top else "\\"


def draw_meridian(grid, rx, hard=False):
    if rx < 1.2:
        for i in range(3 * GH):
            plot(grid, CX, CY - RY * math.cos(math.pi * i / (3 * GH - 1)), "|", hard)
        return
    steps = max(120, int(16 * (rx + RY)))
    for i in range(steps):
        a = 2 * math.pi * i / steps
        plot(grid, CX + rx * math.cos(a), CY + RY * math.sin(a),
             stroke_char(rx, RY, a), hard)


def draw_limb(grid):
    steps = 900
    for i in range(steps):
        a = 2 * math.pi * i / steps
        d = a % (2 * math.pi)
        if d < 0.30 or d > 2 * math.pi - 0.30:
            ch = ")"
        elif abs(d - math.pi) < 0.30:
            ch = "("
        else:
            ch = stroke_char(RX, RY, a)
        plot(grid, CX + RX * math.cos(a), CY + RY * math.sin(a), ch, hard=True)


def frame(rot):
    g = blank()
    for lon in MERIDIAN_LONS:
        draw_meridian(g, abs(math.cos(lon + rot)) * RX)
    for lat in PARALLELS:
        y = CY - math.sin(lat) * RY
        half = int(math.cos(lat) * (RX - 1.0))
        for dx in range(-half, half + 1):
            plot(g, CX + dx, y, "-", hard=True)
    draw_limb(g)
    return "\n".join("".join(row).rstrip() for row in g)


def main():
    caption = LUMON.strip("\n")
    if not TTY:
        write(fg(COLOR) + frame(0.0) + "\n\n" + caption + RESET + "\n")
        return

    cols, _ = term_size()
    pad = " " * max(0, (cols - GW) // 2)

    def emit(body, rgb):
        write(fg(rgb) + "\n".join(pad + ln for ln in body.split("\n")) + RESET + "\n")

    write("\033[2J\033[H")
    turns = 30
    total_spin = 3.0 * math.pi
    for i in range(turns):
        p = i / (turns - 1)
        rot = total_spin * (1 - (1 - (1 - p) ** 3))
        if i:
            write("\033[%dA" % GH)
        emit(frame(rot), COLOR)
        nap(0.03 + 0.045 * p)
    write("\n")
    emit(caption, HOT)
    nap(1.0)


run(main)
