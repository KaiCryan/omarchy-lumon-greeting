#!/usr/bin/env python3
"""'The Board has been notified.' A phone rings, twice. Nobody answers."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _lumon import (  # noqa: E402
    COLOR, DIM, HOT, RESET, TTY, center, fg, nap, run, term_size, write,
)

PHONE = [
    "   ╭──────────────╮   ",
    "╭──┤ ▁▁▁▁▁▁▁▁▁▁▁▁ ├──╮",
    "╰──┤              ├──╯",
    "   │  ·  ·  ·  ·  │   ",
    "   │  ·  ·  ·  ·  │   ",
    "   ╰──────────────╯   ",
]


def draw_phone(rgb, row0, cols, dx=0):
    for i, ln in enumerate(PHONE):
        shifted = (" " * dx + ln) if dx >= 0 else ln[-dx:]
        write(f"\033[{row0 + i};1H\033[2K"
              + center(fg(rgb) + shifted + RESET, cols, len(PHONE[0])))


def main():
    cols, lines = term_size()
    if not TTY:
        write("  The Board has been notified.\n")
        return

    write("\033[2J")
    row = lines // 2
    msg = "The Board has been notified."
    for i in range(len(msg) + 1):
        write(f"\033[{row};1H\033[2K" + center(fg(HOT) + msg[:i] + RESET, cols, i))
        nap(0.055)
    nap(1.5)

    write("\033[2J")
    prow = max(1, lines // 2 - 3)
    for _ring in range(2):
        for beat, dx in enumerate((-1, 1, -1, 1)):
            draw_phone(HOT, prow, cols, dx)
            label = "R I N G" if beat < 3 else "       "
            write(f"\033[{prow + len(PHONE) + 1};1H\033[2K"
                  + center(fg(HOT) + label + RESET, cols, 7))
            nap(0.1)
        nap(0.55)
    draw_phone(DIM, prow, cols, 0)
    write(f"\033[{prow + len(PHONE) + 1};1H\033[2K")
    nap(0.7)
    write(f"\033[{lines - 2};1H\033[2K"
          + center(fg(DIM) + "— no answer —" + RESET, cols, 13))
    nap(1.1)
    write("\033[2J\033[H\n")


run(main)
